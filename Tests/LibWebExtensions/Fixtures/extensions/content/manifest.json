{
    "manifest_version": 3,
    "name": "Content script test extension",
    "version": "1.0",
    "key": "",
    "background": { "service_worker": "background.js" },
    "content_scripts": [
        { "matches": ["file:///*"], "js": ["start.js"], "run_at": "document_start", "all_frames": true },
        { "matches": ["file:///*"], "js": ["main-world.js"], "run_at": "document_start", "world": "MAIN" },
        { "matches": ["file:///*"], "exclude_matches": ["file:///*/excluded.html"], "js": ["end.js"], "run_at": "document_end" }
    ]
}

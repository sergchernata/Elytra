{
    "manifest_version": 3,
    "name": "Management test extension",
    "short_name": "Management",
    "version": "1.0",
    "version_name": "1.0 beta",
    "description": "Exercises chrome.management, chrome.privacy and chrome.runtime",
    "key": "",
    "permissions": ["management", "privacy", "storage"],
    "host_permissions": ["https://granted.example/*"],
    "homepage_url": "https://example.com/home",
    "options_ui": { "page": "options.html" },
    "icons": { "128": "icon128.png", "16": "icon16.png" },
    "offline_enabled": true,
    "background": { "service_worker": "background.js" }
}

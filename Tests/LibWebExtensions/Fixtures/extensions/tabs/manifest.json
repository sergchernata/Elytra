{
    "manifest_version": 3,
    "name": "Tabs test extension",
    "version": "1.0",
    "key": "",
    "permissions": ["tabs", "scripting", "webNavigation"],
    "host_permissions": ["file:///*"],
    "content_scripts": [
        { "matches": ["file:///*"], "js": ["content.js"], "all_frames": true, "run_at": "document_end" }
    ]
}

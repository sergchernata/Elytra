{
    "manifest_version": 3,
    "name": "World isolation test extension",
    "version": "1.0",
    "key": "",
    "background": { "service_worker": "background.js" },
    "content_scripts": [
        { "matches": ["file:///*/isolation.html"], "js": ["content.js"], "run_at": "document_end" },
        { "matches": ["file:///*/isolation-engine.html"], "js": ["engine.js"], "run_at": "document_end" }
    ]
}

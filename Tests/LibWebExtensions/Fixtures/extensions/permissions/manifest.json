{
    "manifest_version": 3,
    "name": "Permissions test extension",
    "version": "1.0",
    "key": "",
    "permissions": ["storage"],
    "optional_permissions": ["notifications", "idle"],
    "host_permissions": ["https://granted.example/*"],
    "optional_host_permissions": ["https://*.optional.example/*"],
    "content_scripts": [{ "matches": ["https://scripted.example/*"], "js": ["content.js"] }],
    "background": { "service_worker": "background.js" }
}

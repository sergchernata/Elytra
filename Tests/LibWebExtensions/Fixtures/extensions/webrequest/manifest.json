{
    "manifest_version": 3,
    "name": "webRequest test extension",
    "version": "1.0",
    "key": "",
    "permissions": ["webRequest", "webRequestAuthProvider", "declarativeNetRequestWithHostAccess", "tabs", "storage"],
    "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
    "declarative_net_request": {
        "rule_resources": [
            { "id": "ruleset_1", "enabled": true, "path": "rules_1.json" },
            { "id": "ruleset_2", "enabled": false, "path": "rules_2.json" }
        ]
    }
}

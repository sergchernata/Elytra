{
    "manifest_version": 3,
    "name": "Security: content scripts and storage",
    "version": "1.0",
    "key": "",
    "permissions": ["storage"],
    "background": { "service_worker": "background.js" },
    "content_scripts": [
        { "matches": ["file:///*/storage-*.html"], "js": ["content.js"], "run_at": "document_end" }
    ]
}

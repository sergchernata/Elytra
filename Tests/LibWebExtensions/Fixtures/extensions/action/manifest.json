{
    "manifest_version": 3,
    "name": "Action test extension",
    "version": "1.0",
    "key": "",
    "permissions": ["storage"],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_title": "Default title",
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/16.png",
            "32": "icons/32.png"
        }
    },
    "commands": {
        "_execute_action": {
            "suggested_key": {
                "default": "Ctrl+Shift+Y",
                "mac": "Command+Shift+Y"
            }
        },
        "lock": {
            "description": "Lock it",
            "suggested_key": {
                "default": "Ctrl+Shift+K"
            }
        },
        "unbound": {
            "description": "No key"
        },
        "bare": {
            "description": "No modifier",
            "suggested_key": {
                "default": "A"
            }
        },
        "media": {
            "description": "Media",
            "suggested_key": {
                "default": "MediaPlayPause"
            }
        },
        "shift_only": {
            "description": "Shift alone",
            "suggested_key": {
                "default": "Shift+B"
            }
        },
        "fifth": {
            "description": "One too many",
            "suggested_key": {
                "default": "Ctrl+Shift+5"
            }
        },
        "sixth": {
            "description": "Two too many",
            "suggested_key": {
                "default": "Alt+Shift+6"
            }
        }
    }
}

{
    "manifest_version": 3,
    "name": "Security: a background with secrets",
    "version": "1.0",
    "key": "",
    "permissions": ["storage"],
    "background": { "service_worker": "background.js" },
    "content_scripts": [
        { "matches": ["https://bank.example/*"], "js": ["content.js"] }
    ]
}
